# Solo para desarrollo local. No reutilizar estos valores en otros ambientes.
DB_HOST=localhost
DB_PORT=3308
DB_NAME=cancelacion_certificados
DB_USERNAME=cancelacion_app
DB_PASSWORD=cancelacion_local_dev
MYSQL_ROOT_PASSWORD=cancelacion_root_local_dev
AVAILABILITY_STALE_ATTEMPT_THRESHOLD=30s
AVAILABILITY_TIMEOUT=1s
AVAILABILITY_MOCK_SIMULATED_TIMEOUT=2s
RECAPTCHA_SECRET_KEY=replace-with-google-recaptcha-v2-secret-key
RECAPTCHA_VERIFY_URI=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_TIMEOUT=3s
RECAPTCHA_ALLOWED_HOSTNAMES=localhost

# Sesión ciudadana local. Generar con: openssl rand -base64 32
SESSION_SIGNING_SECRET=Y2FuY2VsYWNpb24tbG9jYWwtc2Vzc2lvbi1rZXktMzJiIQ==
SESSION_COOKIE_SECURE=false
SESSION_ACCESS_TTL=15m
SESSION_REFRESH_TTL=3d

# ID Perú local: "mock" no requiere credenciales; "real" usa las variables siguientes.
ID_PERU_MODE=mock
ID_PERU_MOCK_SCENARIO=MATCH

# Completar solo para probar ID Perú real con credenciales autorizadas de desarrollo.
# ID_PERU_CLIENT_ID=
# ID_PERU_CLIENT_SECRET=
# Opcional: ya es el valor local predeterminado.
# ID_PERU_REFERER=http://localhost:3000/autorizacion
# APP_FRONTEND_BASE_URL=http://localhost:3000
# APP_BACKEND_BASE_URL=http://localhost:8080
# ID_PERU_FLOW_SECRET=base64-de-32-bytes-aleatorios

# El perfil prod exige externamente estos valores (no colocar secretos reales aquí):
# APP_FRONTEND_BASE_URL=https://frontend.institucional.gob.pe
# APP_BACKEND_BASE_URL=https://backend.institucional.gob.pe
# ID_PERU_CLIENT_ID=
# ID_PERU_CLIENT_SECRET=
# ID_PERU_REFERER=https://frontend.institucional.gob.pe
# ID_PERU_FLOW_SECRET=base64-de-32-bytes-aleatorios
# Listado detallado posterior a ID Perú. Usar mock hasta contar con contrato institucional verificado.
CERTIFICATE_LISTING_MODE=mock
