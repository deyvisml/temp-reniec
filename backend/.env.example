# Solo para desarrollo local. No reutilizar estos valores en otros ambientes.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=cancelacion_certificados
DB_USERNAME=cancelacion_app
DB_PASSWORD=cancelacion_local_dev
MYSQL_ROOT_PASSWORD=cancelacion_root_local_dev
AVAILABILITY_STALE_ATTEMPT_THRESHOLD=30s
AVAILABILITY_TIMEOUT=1s
AVAILABILITY_MOCK_SIMULATED_TIMEOUT=2s
RECAPTCHA_SECRET_KEY=replace-with-google-recaptcha-v2-secret-key
RECAPTCHA_VERIFY_URI=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_TIMEOUT=3s
RECAPTCHA_ALLOWED_HOSTNAMES=localhost
