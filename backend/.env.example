# Solo para desarrollo local. No reutilizar estos valores en otros ambientes.
DB_HOST=localhost
DB_PORT=3308
DB_NAME=revocacion_credenciales_digitales
DB_USERNAME=revocacion_app
DB_PASSWORD=revocacion_local_dev
MYSQL_ROOT_PASSWORD=revocacion_root_local_dev
AVAILABILITY_STALE_ATTEMPT_THRESHOLD=30s
AVAILABILITY_TIMEOUT=15s
AVAILABILITY_MOCK_SIMULATED_TIMEOUT=2s
# Sesión ciudadana local. Generar con: openssl rand -base64 32
SESSION_SIGNING_SECRET=cmV2b2NhY2lvbi1sb2NhbC1zZXNzaW9uLWtleS0zMmJ5dGVzIQ==
SESSION_COOKIE_SECURE=false
SESSION_ACCESS_TTL=15m
SESSION_REFRESH_TTL=3d

# ID Perú real es obligatorio en el perfil local. Completar con credenciales autorizadas de desarrollo.
ID_PERU_CLIENT_ID=
ID_PERU_CLIENT_SECRET=
# Opcional: ya es el valor local predeterminado.
# ID_PERU_REFERER=http://localhost:3000/autorizacion
# APP_FRONTEND_BASE_URL=http://localhost:3000
# APP_BACKEND_BASE_URL=http://localhost:8080
# ID_PERU_FLOW_SECRET=base64-de-32-bytes-aleatorios

# El perfil prod exige externamente estos valores (no colocar secretos reales aquí):
# APP_FRONTEND_BASE_URL=https://frontend.institucional.gob.pe
# APP_BACKEND_BASE_URL=https://backend.institucional.gob.pe
# ID_PERU_CLIENT_ID=
# ID_PERU_CLIENT_SECRET=
# ID_PERU_REFERER=https://frontend.institucional.gob.pe
# ID_PERU_FLOW_SECRET=base64-de-32-bytes-aleatorios
# Réplica local del proveedor oficial. El backend conserva el puerto 8080 y consume la réplica en 8081.
CREDENTIAL_PROVIDER_MODE=real
CREDENTIAL_PROVIDER_BASE_URL=http://localhost:8081
CREDENTIAL_PROVIDER_API_KEY=local-credential-provider-key
CREDENTIAL_PROVIDER_CONNECT_TIMEOUT=3s
CREDENTIAL_PROVIDER_READ_TIMEOUT=10s

# Revocación y constancias locales. La propagación productiva usa 60 segundos por defecto.
REVOCATION_MOCK_OUTCOME=SUCCEEDED
REVOCATION_PROPAGATION_DELAY=60s
RECEIPT_MODE=filesystem
RECEIPT_PROCESSING_ENABLED=true
RECEIPT_PROCESSING_INTERVAL=5s
# En local las constancias se conservan en storage/receipts por defecto.
# RECEIPT_STORAGE_ROOT=storage/receipts
# En producción debe ser una ruta absoluta sobre un volumen persistente con respaldo.
# RECEIPT_STORAGE_ROOT=/var/lib/reniec/revocacion-credenciales/constancias
