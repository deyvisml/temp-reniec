{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "CancellationRequestResponse": {
        "properties": {
          "canContinue": {
            "type": "boolean"
          },
          "eligibilityResult": {
            "enum": [
              "ELIGIBLE",
              "NOT_ELIGIBLE",
              "UNAVAILABLE",
              "INCONCLUSIVE",
              "ERROR"
            ],
            "type": "string"
          },
          "maskedDni": {
            "type": "string"
          },
          "nextStep": {
            "enum": [
              "IDENTITY_VERIFICATION"
            ],
            "type": "string"
          },
          "requestId": {
            "format": "int64",
            "type": "integer"
          },
          "requestStatus": {
            "enum": [
              "STARTED",
              "CHECKING_ELIGIBILITY",
              "NOT_ELIGIBLE",
              "ELIGIBLE",
              "PENDING_IDENTITY_VERIFICATION",
              "IDENTITY_VERIFIED",
              "REASON_REGISTERED",
              "PENDING_CONFIRMATION",
              "CONFIRMED",
              "REVOCATION_IN_PROGRESS",
              "COMPLETED",
              "FAILED",
              "OUTCOME_UNKNOWN",
              "RECEIPT_AVAILABLE",
              "ABANDONED"
            ],
            "type": "string"
          },
          "reused": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "StartCancellationRequest": {
        "properties": {
          "dni": {
            "maxLength": 8,
            "minLength": 8,
            "pattern": "[0-9]{8}",
            "type": "string"
          }
        },
        "required": [
          "dni"
        ],
        "type": "object"
      },
      "SystemStatusResponse": {
        "description": "Estado técnico del backend y su conexión con MySQL",
        "properties": {
          "database": {
            "example": "UP",
            "type": "string"
          },
          "status": {
            "example": "UP",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Contrato técnico versionado del sistema",
    "title": "API de cancelación de certificados digitales",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/cancellation-requests": {
      "post": {
        "operationId": "initiate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartCancellationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancellationRequestResponse"
                }
              }
            },
            "description": "Resultado normalizado de elegibilidad",
            "headers": {
              "X-Correlation-ID": {
                "description": "Identificador de correlación",
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "DNI o cuerpo inválido",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Consulta en curso o conflicto concurrente",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Tipo de contenido no admitido",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Error controlado del proveedor",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Servicio de elegibilidad no disponible",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Tiempo de espera agotado",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          }
        },
        "summary": "Inicia o recupera una solicitud y consulta su elegibilidad",
        "tags": [
          "cancellation-request-controller"
        ]
      }
    },
    "/api/v1/system/status": {
      "get": {
        "operationId": "getStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            },
            "description": "Backend y base de datos disponibles",
            "headers": {
              "X-Correlation-ID": {
                "description": "Identificador de correlación de la solicitud",
                "style": "simple"
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Dependencia técnica no disponible",
            "headers": {
              "X-Correlation-ID": {
                "description": "Identificador de correlación de la solicitud",
                "style": "simple"
              }
            }
          }
        },
        "summary": "Comprueba la disponibilidad del backend y MySQL",
        "tags": [
          "Estado técnico"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Generated server url",
      "url": "http://localhost:8080"
    }
  ]
}
