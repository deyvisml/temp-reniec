    "/api/v1/idperu/callback": {
      "get": {
        "description": "Recibe el retorno del navegador, valida el intento y siempre redirige con HTTP 303 a una ruta frontend fija.",
        "operationId": "handleIdentityCallbackGet",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "session_state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Retorno procesado y redirección controlada"
          }
        },
        "summary": "Procesa el retorno GET de ID Perú",
        "tags": [
          "Verificación de identidad"
        ]
      },
      "post": {
        "description": "Recibe el formulario del proveedor, aplica el mismo caso de uso y siempre redirige con HTTP 303 a una ruta frontend fija.",
        "operationId": "handleIdentityCallbackPost",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  },
                  "session_state": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Retorno procesado y redirección controlada"
          }
        },
        "summary": "Procesa el retorno POST de ID Perú",
        "tags": [
          "Verificación de identidad"
        ]
      }
    },
