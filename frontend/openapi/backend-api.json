{
  "components": {
    "schemas": {
      "ActuatorHealthResponse": {
        "description": "Estado agregado y seguro publicado por Spring Boot Actuator.",
        "properties": {
          "status": {
            "description": "Estado agregado.",
            "example": "UP",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ApiError": {
        "description": "Formato común y seguro de los errores controlados de la API.",
        "properties": {
          "code": {
            "description": "Código público y estable del error.",
            "example": "VALIDATION_ERROR",
            "type": "string"
          },
          "correlationId": {
            "description": "Identificador de correlación para soporte y trazabilidad.",
            "example": "7a5f3f75-3bd2-4c47-90fc-6cfc79f1ec2d",
            "type": "string"
          },
          "message": {
            "description": "Mensaje comprensible sin detalles internos.",
            "example": "La solicitud contiene datos inválidos.",
            "type": "string"
          },
          "path": {
            "description": "Ruta de la solicitud que produjo el error.",
            "example": "/api/v1/cancellation-requests",
            "type": "string"
          },
          "timestamp": {
            "description": "Fecha y hora UTC del error.",
            "example": "2026-07-20T18:30:00Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "code",
          "correlationId",
          "message",
          "path",
          "timestamp"
        ],
        "type": "object"
      },
      "CancellationConfirmationRequest": {
        "description": "Evidencia explícita del consentimiento mostrado en el paso 4.",
        "properties": {
          "consentAccepted": {
            "description": "Aceptación expresa del texto mostrado; debe enviarse con valor true.",
            "type": "boolean"
          },
          "consentVersion": {
            "description": "Versión exacta del consentimiento mostrado por el backend.",
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "consentAccepted",
          "consentVersion"
        ],
        "type": "object"
      },
      "CancellationReasonRequest": {
        "properties": {
          "otherReason": {
            "description": "Descripción requerida únicamente cuando el motivo es OTHER.",
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "reasonCode": {
            "description": "Código controlado del motivo.",
            "enum": [
              "THEFT",
              "LOSS",
              "DEVICE_OR_NUMBER_CHANGE",
              "SUSPECTED_UNAUTHORIZED_USE",
              "OTHER"
            ],
            "type": "string"
          }
        },
        "required": [
          "reasonCode"
        ],
        "type": "object"
      },
      "CancellationReasonResponse": {
        "description": "Motivo registrado para la solicitud activa.",
        "properties": {
          "canContinue": {
            "type": "boolean"
          },
          "nextStep": {
            "type": "string"
          },
          "otherReason": {
            "type": "string"
          },
          "reasonCode": {
            "enum": [
              "THEFT",
              "LOSS",
              "DEVICE_OR_NUMBER_CHANGE",
              "SUSPECTED_UNAUTHORIZED_USE",
              "OTHER"
            ],
            "type": "string"
          },
          "requestStatus": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CancellationRequestResponse": {
        "description": "Resultado normalizado del inicio de una nueva solicitud de cancelación.",
        "properties": {
          "availabilityResult": {
            "description": "Resultado normalizado de la consulta inicial de existencia. No representa una lista detallada.",
            "enum": [
              "AVAILABLE",
              "NOT_AVAILABLE",
              "INCONCLUSIVE",
              "UNAVAILABLE",
              "ERROR"
            ],
            "example": "AVAILABLE",
            "type": "string"
          },
          "canContinue": {
            "description": "Indica si el backend autoriza continuar al siguiente paso.",
            "example": true,
            "type": "boolean"
          },
          "maskedDni": {
            "description": "DNI enmascarado para presentación segura.",
            "example": "******01",
            "type": "string"
          },
          "nextStep": {
            "description": "Siguiente paso autorizado. Es nulo cuando no se permite continuar.",
            "enum": [
              "IDENTITY_VERIFICATION"
            ],
            "example": "IDENTITY_VERIFICATION",
            "type": [
              "string",
              "null"
            ]
          },
          "requestId": {
            "description": "Identificador interno de la solicitud. No funciona como credencial ni autorización.",
            "example": 125,
            "format": "int64",
            "type": "integer"
          },
          "requestStatus": {
            "description": "Estado actual persistido de la solicitud.",
            "enum": [
              "STARTED",
              "CHECKING_AVAILABILITY",
              "NO_CERTIFICATES_AVAILABLE",
              "PENDING_IDENTITY_VERIFICATION",
              "IDENTITY_VERIFIED",
              "AUTHENTICATED_PENDING_CERTIFICATE_LIST",
              "CHECKING_CERTIFICATE_LIST",
              "CERTIFICATES_AVAILABLE",
              "CERTIFICATES_SELECTED",
              "REASON_REGISTERED",
              "PENDING_CONFIRMATION",
              "CONFIRMED",
              "REVOCATION_IN_PROGRESS",
              "REVOCATION_SUCCEEDED",
              "REVOCATION_FAILED",
              "REVOCATION_OUTCOME_UNKNOWN",
              "COMPLETED",
              "FAILED",
              "OUTCOME_UNKNOWN",
              "RECEIPT_AVAILABLE",
              "ABANDONED"
            ],
            "example": "PENDING_IDENTITY_VERIFICATION",
            "type": "string"
          }
        },
        "required": [
          "availabilityResult",
          "canContinue",
          "maskedDni",
          "nextStep",
          "requestId",
          "requestStatus"
        ],
        "type": "object"
      },
      "CancellationReviewResponse": {
        "description": "Resumen autoritativo y minimizado de la cancelación que confirmará el ciudadano.",
        "properties": {
          "certificate": {
            "$ref": "#/components/schemas/SelectedCertificate"
          },
          "confirmed": {
            "type": "boolean"
          },
          "confirmedAt": {
            "description": "Fecha UTC persistida; ausente antes de confirmar.",
            "format": "date-time",
            "type": "string"
          },
          "consentText": {
            "type": "string"
          },
          "consentVersion": {
            "maxLength": 64,
            "type": "string"
          },
          "consequences": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maskedDni": {
            "example": "******91",
            "type": "string"
          },
          "otherReason": {
            "description": "Descripción persistida solo para el motivo OTHER.",
            "type": "string"
          },
          "reasonCode": {
            "type": "string"
          },
          "reasonLabel": {
            "type": "string"
          },
          "requestStatus": {
            "type": "string"
          }
        },
        "required": [
          "certificate",
          "confirmed",
          "consentText",
          "consentVersion",
          "consequences",
          "maskedDni",
          "reasonCode",
          "reasonLabel",
          "requestStatus"
        ],
        "type": "object"
      },
      "CertificateItem": {
        "description": "Certificado vigente obtenido después de autenticar al ciudadano.",
        "properties": {
          "availabilityStatus": {
            "type": "string"
          },
          "certificateUuid": {
            "format": "uuid",
            "type": "string"
          },
          "emissionCreatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "orderNumber": {
            "maxLength": 64,
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          }
        },
        "required": [
          "availabilityStatus",
          "certificateUuid",
          "emissionCreatedAt",
          "orderNumber",
          "selected"
        ],
        "type": "object"
      },
      "CertificateListResponse": {
        "description": "Listado persistido de certificados vigentes de la solicitud autenticada.",
        "properties": {
          "canContinue": {
            "type": "boolean"
          },
          "certificates": {
            "items": {
              "$ref": "#/components/schemas/CertificateItem"
            },
            "type": "array"
          },
          "requestStatus": {
            "type": "string"
          }
        },
        "required": [
          "canContinue",
          "certificates",
          "requestStatus"
        ],
        "type": "object"
      },
      "CertificateSelectionRequest": {
        "description": "Certificado que el ciudadano selecciona para cancelar.",
        "properties": {
          "certificateUuid": {
            "description": "UUID canónico de un certificado disponible de la solicitud activa.",
            "format": "uuid",
            "minLength": 1,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "certificateUuid"
        ],
        "type": "object"
      },
      "CurrentIdentityResponse": {
        "properties": {
          "callbackOutcome": {
            "description": "Resultado efímero del último callback, consumido una sola vez para presentación.",
            "enum": [
              "CANCELLED",
              "REJECTED",
              "IDENTITY_MISMATCH",
              "EXPIRED",
              "TIMEOUT",
              "UNAVAILABLE",
              "ERROR"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "canContinue": {
            "description": "Indica si la autorización temporal permite continuar.",
            "type": "boolean"
          },
          "nextStep": {
            "description": "Siguiente paso autorizado.",
            "enum": [
              "IDENTITY_VERIFICATION",
              "CERTIFICATE_SELECTION"
            ],
            "type": "string"
          },
          "status": {
            "description": "Estado normalizado del intento de identidad.",
            "enum": [
              "STARTED",
              "VERIFIED",
              "REJECTED",
              "CANCELLED",
              "EXPIRED",
              "IDENTITY_MISMATCH",
              "ERROR"
            ],
            "type": "string"
          }
        },
        "required": [
          "canContinue",
          "nextStep",
          "status"
        ],
        "type": "object"
      },
      "CurrentSession": {
        "description": "Contexto seguro de la operación activa y el siguiente paso autorizado.",
        "properties": {
          "dni": {
            "description": "DNI completo mostrado únicamente dentro de la sesión autenticada.",
            "pattern": "^[0-9]{8}$",
            "type": "string"
          },
          "nextStep": {
            "enum": [
              "IDENTITY_VERIFICATION",
              "CERTIFICATE_SELECTION",
              "REASON",
              "CONFIRMATION"
            ],
            "type": "string"
          },
          "requestId": {
            "description": "Identificador técnico de solicitud.",
            "format": "int64",
            "type": "integer"
          },
          "requestStatus": {
            "description": "Estado controlado de la solicitud.",
            "type": "string"
          },
          "sessionId": {
            "description": "Identificador técnico de sesión.",
            "format": "int64",
            "type": "integer"
          },
          "sessionStatus": {
            "enum": [
              "PENDING_IDENTITY",
              "IDENTITY_VERIFIED"
            ],
            "type": "string"
          }
        },
        "required": [
          "dni",
          "nextStep",
          "requestId",
          "requestStatus",
          "sessionId",
          "sessionStatus"
        ],
        "type": "object"
      },
      "IdentityStartResponse": {
        "properties": {
          "authorizationUrl": {
            "description": "URL de autorización construida por el backend.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "authorizationUrl"
        ],
        "type": "object"
      },
      "SelectedCertificate": {
        "description": "Certificado seleccionado presentado sin exponer su UUID completo.",
        "properties": {
          "emissionCreatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "maskedUuid": {
            "example": "11111111…1111",
            "type": "string"
          },
          "orderNumber": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "emissionCreatedAt",
          "maskedUuid",
          "orderNumber"
        ],
        "type": "object"
      },
      "StartCancellationRequest": {
        "description": "Datos requeridos para iniciar una nueva solicitud y consultar si existen certificados disponibles.",
        "properties": {
          "dni": {
            "description": "Número de DNI del ciudadano. Debe contener exactamente ocho dígitos ASCII. Por privacidad, la documentación no incluye un DNI completo de ejemplo.",
            "maxLength": 8,
            "minLength": 8,
            "pattern": "[0-9]{8}",
            "type": "string"
          },
          "recaptchaToken": {
            "description": "Evidencia efímera de Google reCAPTCHA v2 Checkbox. No se almacena ni se devuelve.",
            "maxLength": 4096,
            "minLength": 0,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "dni",
          "recaptchaToken"
        ],
        "type": "object"
      },
      "SystemStatusResponse": {
        "description": "Estado técnico del backend y su conexión con MySQL",
        "properties": {
          "database": {
            "description": "Disponibilidad de la conexión comprobada con MySQL.",
            "example": "UP",
            "type": "string"
          },
          "status": {
            "description": "Estado agregado del backend.",
            "example": "UP",
            "type": "string"
          },
          "timestamp": {
            "description": "Fecha y hora UTC de la comprobación.",
            "example": "2026-07-20T18:30:00Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "database",
          "status",
          "timestamp"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "FlowRefreshCookie": {
        "description": "Refresh JWT rotatorio, transportado exclusivamente mediante cookie HttpOnly.",
        "in": "cookie",
        "name": "cancelacion_refresh",
        "type": "apiKey"
      },
      "FlowSessionCookie": {
        "description": "Access JWT de la sesión transaccional, transportado exclusivamente mediante cookie HttpOnly.",
        "in": "cookie",
        "name": "cancelacion_access",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "RENIEC"
    },
    "description": "API institucional para iniciar el flujo ciudadano. La consulta pública exige Google reCAPTCHA v2 Checkbox y la autenticación usa ID Perú con continuidad temporal HttpOnly.",
    "title": "API de cancelación de certificados digitales",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actuator/health": {
      "get": {
        "description": "Informa si la aplicación y sus dependencias configuradas están operativas sin exponer detalles internos.",
        "operationId": "getActuatorHealth",
        "parameters": [
          {
            "description": "Identificador opcional de correlación. Debe tener entre 1 y 64 caracteres ASCII válidos.",
            "in": "header",
            "name": "X-Correlation-ID",
            "required": false,
            "schema": {
              "maxLength": 64,
              "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActuatorHealthResponse",
                  "type": "object"
                }
              }
            },
            "description": "Aplicación operativa",
            "headers": {
              "X-Correlation-ID": {
                "description": "Identificador de correlación de la solicitud",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActuatorHealthResponse",
                  "type": "object"
                }
              }
            },
            "description": "Aplicación o dependencia no disponible",
            "headers": {
              "X-Correlation-ID": {
                "description": "Identificador de correlación de la solicitud",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Comprueba la salud operativa agregada",
        "tags": [
          "Estado técnico"
        ]
      }
    },
    "/api/v1/cancellation-requests": {
      "post": {
        "description": "Valida el DNI y Google reCAPTCHA v2 Checkbox antes de crear una solicitud y consultar únicamente si existe al menos un certificado disponible para cancelar. No obtiene una lista, cantidad, número de orden, fecha de creación ni UUID; tampoco reabre solicitudes anteriores ni expone el DNI completo o la evidencia anti-bot.",
        "operationId": "initiateCancellationRequest",
        "parameters": [
          {
            "description": "Identificador opcional de correlación. Debe tener entre 1 y 64 caracteres ASCII válidos.",
            "in": "header",
            "name": "X-Correlation-ID",
            "schema": {
              "maxLength": 64,
              "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartCancellationRequest"
              }
            }
          },
          "description": "DNI y evidencia efímera reCAPTCHA que se validan en el backend antes de crear una solicitud.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancellationRequestResponse"
                }
              }
            },
            "description": "Resultado normalizado de existencia de certificados",
            "headers": {
              "X-Correlation-ID": {
                "description": "Identificador de correlación",
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "DNI, JSON, cuerpo o evidencia reCAPTCHA inválida: VALIDATION_ERROR, RECAPTCHA_REQUIRED, RECAPTCHA_REJECTED o RECAPTCHA_EXPIRED_OR_DUPLICATE",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflicto controlado: AVAILABILITY_CHECK_IN_PROGRESS, CANCELLATION_REQUEST_IN_PROGRESS o CONCURRENT_REQUEST",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Tipo de contenido no admitido",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Error interno controlado",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "RECAPTCHA_INVALID_RESPONSE o error controlado del proveedor de disponibilidad",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "RECAPTCHA_UNAVAILABLE o servicio de disponibilidad no disponible",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "RECAPTCHA_TIMEOUT o tiempo de espera agotado en disponibilidad",
            "headers": {
              "X-Correlation-ID": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              }
            }
          }
        },
        "summary": "Inicia una solicitud y consulta si existen certificados disponibles",
        "tags": [
          "Solicitudes de cancelación"
        ]
      }
    },
    "/api/v1/cancellation-requests/current/certificate-selection": {
      "put": {
        "description": "Reemplazo idempotente de la selección singular. El UUID debe pertenecer al listado persistido de la solicitud autenticada.",
        "operationId": "replaceCurrentCertificateSelection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateSelectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateListResponse"
                }
              }
            },
            "description": "Selección persistida y paso 3 habilitado"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Formato inválido"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Sesión ausente o expirada"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Origen o paso no permitido"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Actualización concurrente de la selección"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "UUID ajeno o no disponible"
          }
        },
        "security": [
          {
            "FlowSessionCookie": []
          }
        ],
        "summary": "Selecciona un certificado de la solicitud activa",
        "tags": [
          "Certificados vigentes"
        ]
      }
    },
    "/api/v1/cancellation-requests/current/certificates": {
      "get": {
        "description": "Consulta el segundo servicio solo en la primera carga y luego devuelve la instantánea persistida. No recibe DNI ni identificadores de solicitud desde el navegador.",
        "operationId": "getCurrentRequestCertificates",
        "responses": {
          "200": {
            "content": {
              "application/json": {
